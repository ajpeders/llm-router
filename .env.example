LLM_ROUTER_DOMAIN=llm-router.yourdomain.com
# name -> llama-swap (or Ollama) base URL, OpenAI-API compatible. Same model IDs on every backend.
LLM_ROUTER_BACKENDS_JSON={"luna":"http://desktop-ip:11434","mac":"http://mac-ip:11434"}
# Slot count assumed for a model until its llama-server reports /slots
# LLM_ROUTER_DEFAULT_SLOTS=2
# Total cap on a batch job's run (non-streaming, so this is the real ceiling)
# LLM_ROUTER_BATCH_TIMEOUT_MS=1800000
# Total cap on an interactive /v1 request with stream != true — its headers only
# arrive once generation is fully done, so the short streaming first-byte timeout
# is the wrong cap for it (same reasoning as the batch cap above)
# LLM_ROUTER_NONSTREAM_TIMEOUT_MS=1800000
# Quiet window /idle uses to decide the router itself is idle
# LLM_ROUTER_IDLE_WINDOW_MS=120000
# Dead-job alerts (ntfy topic URL + write token)
# LLM_ROUTER_NTFY_URL=http://ntfy/homelab-alerts
# LLM_ROUTER_NTFY_TOKEN=
