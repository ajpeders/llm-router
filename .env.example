LLM_ROUTER_DOMAIN=llm.yourdomain.com
LLM_ROUTER_BACKEND_TIER=mac,arch
LLM_ROUTER_BACKENDS_JSON={"mac":"http://your-mac-ip:11434","arch":"http://your-arch-ip:11434"}

# MiniMax cloud provider (optional — local Ollama is the default)
# Set LLM_ROUTER_MINIMAX_API_KEY to enable. Without it, all traffic goes local.
# LLM_ROUTER_MINIMAX_API_KEY=your_minimax_key
# LLM_ROUTER_MINIMAX_MODEL=MiniMax-Text-01
# LLM_ROUTER_MINIMAX_API_BASE=https://api.minimax.chat/v1
# LLM_ROUTER_MINIMAX_PRIORITY=fallback   # "fallback" (default) or "primary"

# Optional overrides (defaults shown):
# LLM_ROUTER_MODEL_REFRESH_MS=30000
# LLM_ROUTER_TAGS_TIMEOUT_MS=4000
# LLM_ROUTER_REQUEST_TIMEOUT_MS=300000
